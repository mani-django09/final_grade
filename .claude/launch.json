{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "grade-calc-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "grade-calc-nowatch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["cross-env", "NODE_ENV=development", "tsx", "server/_core/index.ts"],
      "port": 3000
    },
    {
      "name": "grade-calc-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["cross-env", "NODE_ENV=production", "node", "dist/index.js"],
      "port": 3000
    }
  ]
}
